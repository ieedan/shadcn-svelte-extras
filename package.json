{
	"name": "shadcn-svelte-extras",
	"packageManager": "pnpm@10.23.0",
	"version": "7.1.3",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n 'registry,app,content' -c 'blue,green,yellow' \"pnpm registry:dev\"  \"pnpm dev:app\" \"pnpm dev:content\"",
		"dev:app": "vite dev",
		"dev:content": "velite dev --watch",
		"build": "pnpm pre:build && vite build",
		"sync": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"registry:build": "jsrepo build",
		"registry:dev": "jsrepo build --watch",
		"ci:release": "jsrepo publish && changeset tag",
		"generate-i18n": "pnpm paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"pre:build": "pnpm sync && pnpm registry:build"
	},
